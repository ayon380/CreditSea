{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "creditsea-frontend": {
      "root": "client",
      "framework": "nextjs",
      "buildCommand": "npm install && npm run build"
    },
    "creditsea-backend": {
      "root": "server",
      "framework": "express",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "creditsea-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "creditsea-frontend"
      }
    }
  ]
}
