# ==========================================================
# CreditSea Loan Management System (LMS) - Root Environment
# ==========================================================

# Backend Configuration (server/.env)
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/creditsea?retryWrites=true&w=majority
JWT_SECRET=super_secret_creditsea_jwt_key_2026_production_secure_token
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Optional Cloudinary Configuration (Server has local storage fallback if left empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Configuration (client/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5001/api
